  @override
  Future<List<{{name.pascalCase()}}Entity>> getAll() async {
    try {
      final data = await _provider.fetchAll();
      _cache.write(_cacheKey, data);
      return data.map((json) => {{name.pascalCase()}}Model.fromJson(json)).toList();
    } catch (_) {
      final cached = _cache.read<List>(_cacheKey) ?? [];
      return cached
          .cast<Map<String, dynamic>>()
          .map((json) => {{name.pascalCase()}}Model.fromJson(json))
          .toList();
    }
  }

  @override
  Future<{{name.pascalCase()}}Entity?> getById(String id) async {
    try {
      final json = await _provider.fetchById(id);
      if (json == null) return null;
      return {{name.pascalCase()}}Model.fromJson(json);
    } catch (_) {
      final cached = _cache.read<List>(_cacheKey) ?? [];
      final match = cached
          .cast<Map<String, dynamic>>()
          .where((e) => e['id'] == id)
          .firstOrNull;
      return match != null ? {{name.pascalCase()}}Model.fromJson(match) : null;
    }
  }

  @override
  Future<void> save({{name.pascalCase()}}Entity entity) async {
    final model = {{name.pascalCase()}}Model.fromEntity(entity);
    await _provider.save(model.toJson());
    _cache.remove(_cacheKey);
  }

  @override
  Future<void> delete(String id) async {
    await _provider.delete(id);
    _cache.remove(_cacheKey);
  }
